# =============================================================================
# MSME Pathways backend environment — DEVELOPMENT
# =============================================================================
# Values are grouped by subsystem. Existing effective values were preserved.
# Duplicate keys were consolidated by retaining their last effective value.
# Before deployment: rotate every secret and follow each Production note.
# Do not commit this file. It is intentionally ignored by Git.

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
# Development: keep True. Production: change to False.
DEBUG= #False for production, True for development
# Production: rotate to a new high-entropy value and store it in the deployment secret manager.
SECRET_KEY=
# Development: local/LAN hosts are acceptable. Production: use only exact API hostnames; never use *.
ALLOWED_HOSTS= #Add your production domain here when deploying, else keep it as is for local development
# Development: 0. Production: set to the exact number of trusted reverse proxies.
TRUSTED_PROXY_COUNT=
# Minimum seconds between ActiveSession last-active writes; 300 is recommended.
SESSION_ACTIVITY_HEARTBEAT_SECONDS=
# Disable only when Channels/WebSocket delivery is intentionally unavailable.
WEBSOCKET_ENABLED=

# -----------------------------------------------------------------------------
# Cryptography and account security
# -----------------------------------------------------------------------------
# Production: rotate before launch, then keep stable; changing it invalidates existing password hashes.
# Management-command note: manage.py currently requires this to be exported before Django loads .env.
SECRET_PEPPER=
# Primary write key. Generate with Fernet.generate_key(); never remove an old key before rotation verification succeeds.
FIELD_ENCRYPTION_KEY=
# During rotation: put the former key(s) here, newest first, comma-separated. Remove only after verification and rollback window.
FIELD_ENCRYPTION_PREVIOUS_KEYS=
# Development: False may ease legacy inspection. Production: True so corruption/wrong keys fail closed.
FIELD_ENCRYPTION_STRICT_DECRYPTION=

# -----------------------------------------------------------------------------
# HTTPS, cookies, CORS, and CSRF
# -----------------------------------------------------------------------------
# Development: False. Production: True unless HTTPS redirection is guaranteed and verified at the proxy.
SECURE_SSL_REDIRECT=
# Development: 0. Production: start cautiously, then use 31536000 after HTTPS is proven.
SECURE_HSTS_SECONDS=
# Development: False. Production: True only when every subdomain supports HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Development: False. Production: enable only after satisfying browser preload requirements.
SECURE_HSTS_PRELOAD=
# Development: True is convenient. Production: False.
CORS_ALLOW_ALL_ORIGINS=
# Development: may be empty while allow-all is enabled. Production: comma-separated exact HTTPS frontend origins.
CORS_ALLOWED_ORIGINS=
# Development: local HTTP origins are acceptable. Production: exact HTTPS browser origins only.
CSRF_TRUSTED_ORIGINS=
# Use Lax for same-site clients; use None only for a cross-site browser frontend and only with Secure=True.
AUTH_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
AUTH_COOKIE_SECURE=
# Keep True in development and production.
AUTH_COOKIE_HTTPONLY=
# Use Lax for same-site clients; use None only when cross-site behavior is required with Secure=True.
SESSION_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
SESSION_COOKIE_SECURE=
# Keep True.
SESSION_COOKIE_HTTPONLY=
# Use Lax for same-site clients; coordinate with the web frontend if cross-site.
CSRF_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
CSRF_COOKIE_SECURE=
# Keep False for the double-submit CSRF header pattern used by browser clients.
CSRF_COOKIE_HTTPONLY=

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Production: replace with the production cluster URI, TLS enabled, least-privilege database user, and restricted network access.
MONGODB_URI=
# Production: use the dedicated production database name.
MONGODB_NAME=

# -----------------------------------------------------------------------------
# Redis, Channels, Celery, and cache
# -----------------------------------------------------------------------------
# Channels currently reads this host-only value. Production Redis with TLS/auth may require a settings change to consume REDIS_URL consistently.
REDIS_HOST=
# Development: local Redis URL. Production: managed Redis URL, preferably TLS (rediss://).
REDIS_URL=
# Development: optional. Production: must be True so throttles and django-axes share state across workers.
USE_REDIS_CACHE=
# Development: local Redis. Production: managed Redis/broker URL.
CELERY_BROKER_URL=
# Development: local Redis. Production: managed result backend or disable result storage if intentionally unused.
CELERY_RESULT_BACKEND=

# -----------------------------------------------------------------------------
# Email and support
# -----------------------------------------------------------------------------
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
# Production: replace with the approved transactional-email account.
EMAIL_HOST_USER=
# Production: rotate and store as a deployment secret/app password.
EMAIL_HOST_PASSWORD=
# Production: use a verified sender identity/domain.
DEFAULT_FROM_EMAIL=
# Production: use the monitored privacy/support mailbox.
SUPPORT_EMAIL=
# Seconds before email delivery attempts time out.
EMAIL_TIMEOUT=

# -----------------------------------------------------------------------------
# Consent policy
# -----------------------------------------------------------------------------
# Change only when the policy family/document identity changes.
CONSENT_POLICY_ID=
# Increment whenever material policy content changes; clients must re-consent.
CONSENT_POLICY_VERSION=
# Use the approved policy effective timestamp in UTC.
CONSENT_POLICY_EFFECTIVE_AT=
# Must identify the exact reviewed policy document presented to customers.
CONSENT_POLICY_DOCUMENT_URI=
# Must equal the SHA-256 of that exact policy document whenever its content changes.
CONSENT_POLICY_CONTENT_SHA256=

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Development: groq or ollama. Production: choose only an approved provider.
LLM_PROVIDER=
# Production: rotate and store in the deployment secret manager.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHAT_MODEL=
GROQ_QUALIFICATION_MODEL=
# Production: use only an authenticated/private approved endpoint if Ollama is selected.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# -----------------------------------------------------------------------------
# Documents and object storage
# -----------------------------------------------------------------------------
DOCUMENT_UPLOAD_AI_ANALYSIS=
DOCUMENT_UPLOAD_NOTIFY_REVIEWERS=
DOCUMENT_UPLOAD_NOTIFY_ASYNC=
# Development remains local. Production S3 requires a code change because config/settings.py currently hard-codes local storage and does not load this variable.
DOCUMENT_STORAGE_BACKEND=
# Leave empty for local development. Production: prefer workload/IAM identity; otherwise store a restricted key as a secret.
AWS_ACCESS_KEY_ID=
# Leave empty for local development. Production: prefer workload/IAM identity; otherwise rotate and store securely.
AWS_SECRET_ACCESS_KEY=
# Leave empty for local development. Production: private dedicated bucket after S3 settings are wired.
AWS_STORAGE_BUCKET_NAME=
# Production: set to the deployed bucket region.
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=
AWS_S3_SIGNATURE_VERSION=
AWS_S3_OBJECT_PARAMETERS=
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=

# -----------------------------------------------------------------------------
# Encrypted backups
# -----------------------------------------------------------------------------
# Production: rotate before launch and escrow securely; losing it makes backups unrecoverable.
BACKUP_ENCRYPTION_PASSPHRASE= ++lv
# Development: local path. Production: protected volume outside the application checkout.
BACKUP_OUTPUT_DIR=
# Production: set from the approved retention policy.
BACKUP_RETENTION_DAYS=
# Development may stay empty. Production: configure an encrypted offsite destination.
BACKUP_OFFSITE_RCLONE_REMOTE=
# Keep pointed at a non-production restore-test database.
BACKUP_RESTORE_DB_NAME=

# -----------------------------------------------------------------------------
# Blockchain runtime
# -----------------------------------------------------------------------------
# Development: enable only with a local/test chain. Production: enable only after contract, wallet, and network review.
BLOCKCHAIN_ENABLED=
# Production: replace with the approved authenticated RPC endpoint.
BLOCKCHAIN_RPC_URL=
# Production: set to the exact deployed network chain ID.
BLOCKCHAIN_CHAIN_ID=
# Production: rotate and use managed signing/HSM custody where possible. Never reuse a development key.
BLOCKCHAIN_WALLET_KEY=
# Production: replace with reviewed deployment addresses for the selected chain.
BLOCKCHAIN_CONTRACT_ADDRESSES=
BLOCKCHAIN_GAS_LIMIT=
BLOCKCHAIN_GAS_PRICE_GWEI=
# Development can remain empty. Production: set the explorer base URL for the selected network.
BLOCKCHAIN_EXPLORER_URL=
# Development local chain: 1. Production: choose based on network reorg/finality risk.
LOANS_WALLET_MIN_CONFIRMATIONS=

# -----------------------------------------------------------------------------
# Legacy blockchain variables (not consumed by Django settings)
# -----------------------------------------------------------------------------
# Legacy and unused by config/settings.py. Duplicate definitions were consolidated using the last effective value; remove after credential rotation and confirming no external script depends on it.
PRIVATE_KEY=
# Legacy and unused by config/settings.py; remove after confirming no external tooling depends on it.
BACKEND_WALLET=
# Development-only secret; never deploy and remove before production.
GANACHE_MNEMONIC=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
GANACHE_RPC_URL=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
LOCALHOST_RPC_URL=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
SEPOLIA_RPC_URL=
