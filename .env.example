# =============================================================================
# MSME Pathways backend environment — DEVELOPMENT
# =============================================================================
# Values are grouped by subsystem. Existing effective values were preserved.
# Duplicate keys were consolidated by retaining their last effective value.
# Before deployment: rotate every secret and follow each Production note.
# Do not commit this file. It is intentionally ignored by Git.

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
# Development: keep True. Production: change to False.
DEBUG= #False for production, True for development
# Production: rotate to a new high-entropy value and store it in the deployment secret manager.
SECRET_KEY=
# Development: local/LAN hosts are acceptable. Production: use only exact API hostnames; never use *.
ALLOWED_HOSTS= #Add your production domain here when deploying, else keep it as is for local development
# Development: 0. Production: set to the exact number of trusted reverse proxies.
TRUSTED_PROXY_COUNT=
# Minimum seconds between ActiveSession last-active writes; 300 is recommended.
SESSION_ACTIVITY_HEARTBEAT_SECONDS=
# Disable only when Channels/WebSocket delivery is intentionally unavailable.
WEBSOCKET_ENABLED=
# Maximum MongoDB skip accepted by the notification inbox; keep 10000 unless a reviewed query/load test supports another value.
NOTIFICATIONS_MAX_OFFSET=10000
# Maximum rows one mark-all/clear-all request may mutate; larger inboxes must be processed through a future bounded workflow.
NOTIFICATIONS_BULK_MUTATION_LIMIT=1000
# Authenticated notification API limits. These development defaults may be tuned after production load evidence.
NOTIFICATIONS_READ_RATE=600/hour
NOTIFICATIONS_WRITE_RATE=300/hour
NOTIFICATIONS_DEVICE_TOKEN_RATE=60/hour
# Active registrations expire unless refreshed; clients should register after login/token refresh.
NOTIFICATIONS_DEVICE_TOKEN_TTL_DAYS=180
# Per-account device bound and Firebase's maximum multicast request size.
NOTIFICATIONS_MAX_ACTIVE_DEVICE_TOKENS=20
NOTIFICATIONS_FCM_BATCH_SIZE=500
# Durable shared delivery retry/lease controls. Keep the policy version stable for one approved behavior set.
NOTIFICATIONS_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATIONS_DELIVERY_RETRY_BACKOFF_SECONDS=60
NOTIFICATIONS_DELIVERY_LEASE_SECONDS=300
NOTIFICATIONS_PREFERENCE_POLICY_VERSION=2026-08-28-v1
# Privacy lifecycle defaults. Review retention periods with the approved privacy policy before deployment.
NOTIFICATIONS_RETENTION_DAYS=365
NOTIFICATIONS_DELIVERY_RETENTION_DAYS=90
NOTIFICATIONS_INACTIVE_TOKEN_RETENTION_DAYS=30
NOTIFICATIONS_ACCOUNT_EXPORT_MAX_ROWS=1000
# Per-WebSocket connection action limit; production still requires proxy/connection controls.
NOTIFICATIONS_WS_ACTIONS_PER_MINUTE=120
# Review these WebSocket limits against mobile reconnect behavior and proxy limits.
NOTIFICATIONS_WS_REVALIDATE_SECONDS=30
NOTIFICATIONS_WS_IDLE_TIMEOUT_SECONDS=300
NOTIFICATIONS_WS_MAX_MESSAGE_BYTES=16384
NOTIFICATIONS_WS_MAX_CONNECTIONS_PER_USER=5
# Alert/readiness thresholds; tune using normal delivery traffic before production.
NOTIFICATIONS_HEALTH_FAILED_DELIVERY_LIMIT=0
NOTIFICATIONS_HEALTH_OLDEST_PENDING_SECONDS=900
# Stage 6 read-only inventory ceiling.
NOTIFICATIONS_RELEASE_INVENTORY_LIMIT=10000
# Stage 6 evidence flags. Keep False during development. Set True only after the
# named proof passes in the final topology and an authorized reviewer records it.
NOTIFICATIONS_RETENTION_POLICY_APPROVED=False
NOTIFICATIONS_DEPLOYMENT_MONGODB_VERIFIED=False
NOTIFICATIONS_REDIS_CHANNELS_CELERY_VERIFIED=False
NOTIFICATIONS_SMTP_VERIFIED=False
NOTIFICATIONS_FIREBASE_VERIFIED=False
NOTIFICATIONS_HTTPS_WSS_LOAD_VERIFIED=False
NOTIFICATIONS_BACKUP_RESTORE_VERIFIED=False
NOTIFICATIONS_SECRET_ROTATION_VERIFIED=False
NOTIFICATIONS_INCIDENT_ROLLBACK_APPROVED=False
NOTIFICATIONS_MONITORING_ALERTS_VERIFIED=False
NOTIFICATIONS_FULL_SUITE_SMOKE_VERIFIED=False

# -----------------------------------------------------------------------------
# Cryptography and account security
# -----------------------------------------------------------------------------
# Production: rotate before launch, then keep stable; changing it invalidates existing password hashes.
# Management-command note: manage.py currently requires this to be exported before Django loads .env.
SECRET_PEPPER=
# Production: rotate through an approved data re-encryption procedure; never replace it while encrypted records still use the old key. 
# Primary write key. Generate with Fernet.generate_key(); never remove an old key before rotation verification succeeds.
FIELD_ENCRYPTION_KEY=
# During rotation: put the former key(s) here, newest first, comma-separated. Remove only after verification and rollback window.
FIELD_ENCRYPTION_PREVIOUS_KEYS=
# Development: False may ease legacy inspection. Production: True so corruption/wrong keys fail closed.
FIELD_ENCRYPTION_STRICT_DECRYPTION=

# -----------------------------------------------------------------------------
# HTTPS, cookies, CORS, and CSRF
# -----------------------------------------------------------------------------
# Development: False. Production: True unless HTTPS redirection is guaranteed and verified at the proxy.
SECURE_SSL_REDIRECT=
# Development: 0. Production: start cautiously, then use 31536000 after HTTPS is proven.
SECURE_HSTS_SECONDS=
# Development: False. Production: True only when every subdomain supports HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Development: False. Production: enable only after satisfying browser preload requirements.
SECURE_HSTS_PRELOAD=
# Development: True is convenient. Production: False.
CORS_ALLOW_ALL_ORIGINS=
# Development: may be empty while allow-all is enabled. Production: comma-separated exact HTTPS frontend origins.
CORS_ALLOWED_ORIGINS=
# Development: local HTTP origins are acceptable. Production: exact HTTPS browser origins only.
CSRF_TRUSTED_ORIGINS=
# Use Lax for same-site clients; use None only for a cross-site browser frontend and only with Secure=True.
AUTH_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
AUTH_COOKIE_SECURE=
# Keep True in development and production.
AUTH_COOKIE_HTTPONLY=
# Access cookie must reach both /api/ and /ws/notifications/.
AUTH_ACCESS_COOKIE_PATH=/
# Refresh credentials remain limited to authentication endpoints.
AUTH_REFRESH_COOKIE_PATH=/api/auth/
# Use Lax for same-site clients; use None only when cross-site behavior is required with Secure=True.
SESSION_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
SESSION_COOKIE_SECURE=
# Keep True.
SESSION_COOKIE_HTTPONLY=
# Use Lax for same-site clients; coordinate with the web frontend if cross-site.
CSRF_COOKIE_SAMESITE=
# Development over HTTP: False. Production: True.
CSRF_COOKIE_SECURE=
# Keep False for the double-submit CSRF header pattern used by browser clients.
CSRF_COOKIE_HTTPONLY=

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Production: replace with the production cluster URI, TLS enabled, least-privilege database user, and restricted network access.
# Production: use the dedicated production database name.
MONGODB_NAME=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# -----------------------------------------------------------------------------
# Redis, Channels, Celery, and cache
# -----------------------------------------------------------------------------
# Channels currently reads this host-only value. Production Redis with TLS/auth may require a settings change to consume REDIS_URL consistently.
REDIS_HOST=
# Development: local Redis URL. Production: managed Redis URL, preferably TLS (rediss://).
REDIS_URL=
# Development: optional. Production: must be True so throttles and django-axes share state across workers.
USE_REDIS_CACHE=
# Development: local Redis. Production: managed Redis/broker URL.
CELERY_BROKER_URL=
# Development: local Redis. Production: managed result backend or disable result storage if intentionally unused.
CELERY_RESULT_BACKEND=

# -----------------------------------------------------------------------------
# Email and support
# -----------------------------------------------------------------------------
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
# Production: replace with the approved transactional-email account.
EMAIL_HOST_USER=
# Production: rotate and store as a deployment secret/app password.
EMAIL_HOST_PASSWORD=
# Production: use a verified sender identity/domain.
DEFAULT_FROM_EMAIL=
# Production: use the monitored privacy/support mailbox.
SUPPORT_EMAIL=
# Seconds before email delivery attempts time out.
EMAIL_TIMEOUT=

# -----------------------------------------------------------------------------
# Consent policy
# -----------------------------------------------------------------------------
# Change only when the policy family/document identity changes.
CONSENT_POLICY_ID=
# Increment whenever material policy content changes; clients must re-consent.
CONSENT_POLICY_VERSION=
# Use the approved policy effective timestamp in UTC.
CONSENT_POLICY_EFFECTIVE_AT=
# Must identify the exact reviewed policy document presented to customers.
CONSENT_POLICY_DOCUMENT_URI=
# Must equal the SHA-256 of that exact policy document whenever its content changes.
CONSENT_POLICY_CONTENT_SHA256=

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Production incident kill switch. Set False and restart workers to disable
# provider-backed chat/stream while retaining authenticated static AI content.
AI_ASSISTANT_ENABLED=True
# Development: groq or ollama. Production: choose only an approved provider.
LLM_PROVIDER=
# Production: rotate and store in the deployment secret manager.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHAT_MODEL=
GROQ_QUALIFICATION_MODEL=
# Production: use only an authenticated/private approved endpoint if Ollama is selected.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Testing default is 100 requests per user per hour. Set the approved production
# cost policy before deployment.
AI_ASSISTANT_CHAT_RATE=100/hour
# Reject oversized prompts before content filtering or provider billing.
AI_ASSISTANT_MESSAGE_MAX_CHARS=4000
AI_ASSISTANT_MESSAGE_MAX_BYTES=16000
AI_ASSISTANT_REQUEST_MAX_BYTES=20000
AI_ASSISTANT_HISTORY_SEARCH_MAX_CHARS=200
AI_ASSISTANT_HISTORY_MAX_PAGE=200
# Must exceed the longest allowed multi-round provider/stream execution.
AI_ASSISTANT_IDEMPOTENCY_LEASE_SECONDS=900
# Provider cost and execution limits; tune from deployment load-test evidence.
AI_ASSISTANT_MAX_OUTPUT_TOKENS=512
AI_ASSISTANT_STREAM_MAX_CHARS=32768
AI_ASSISTANT_STREAM_MAX_BYTES=131072
AI_ASSISTANT_STREAM_MAX_DURATION_SECONDS=120
AI_ASSISTANT_MAX_TOOL_ROUNDS=3
AI_ASSISTANT_MAX_TOOL_CALLS_PER_REQUEST=6
# Weighted read-only tool budget. Expensive aggregations consume multiple units.
AI_ASSISTANT_TOOL_COST_PER_MINUTE=30
AI_ASSISTANT_TOOL_COST_PER_HOUR=200
AI_ASSISTANT_MAX_CONCURRENT_REQUESTS=8
AI_ASSISTANT_CONNECT_TIMEOUT_SECONDS=5
AI_ASSISTANT_READ_TIMEOUT_SECONDS=120
# Retries apply only to safe readiness GETs, never paid chat POSTs.
AI_ASSISTANT_PROVIDER_RETRY_ATTEMPTS=2
AI_ASSISTANT_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
AI_ASSISTANT_CIRCUIT_FAILURE_THRESHOLD=5
AI_ASSISTANT_CIRCUIT_RECOVERY_SECONDS=30
# AI conversation text uses FIELD_ENCRYPTION_KEY. Production: approve and
# version the retention policy before changing these values.
AI_ASSISTANT_RETENTION_DAYS=365
# Metadata-only tool audit retention. Confirm the period with security/compliance.
AI_ASSISTANT_AUDIT_RETENTION_DAYS=90
AI_ASSISTANT_RETENTION_POLICY_VERSION=2026-08-14-v1
# Stage 6 release evidence. Keep False/blank in development. In production,
# store the approved quality report outside the repository and set each flag
# True only after its named deployment exercise has evidence and sign-off.
AI_ASSISTANT_QUALITY_REPORT_PATH=
AI_ASSISTANT_PROVIDER_PRIVACY_APPROVED=False
AI_ASSISTANT_PROVIDER_CONTRACT_VERIFIED=False
AI_ASSISTANT_REDIS_VERIFIED=False
AI_ASSISTANT_PROXY_STREAMING_VERIFIED=False
AI_ASSISTANT_LOAD_TEST_VERIFIED=False
AI_ASSISTANT_BACKUP_RESTORE_VERIFIED=False
AI_ASSISTANT_SECRET_ROTATION_VERIFIED=False
AI_ASSISTANT_INCIDENT_ROLLBACK_APPROVED=False

# -----------------------------------------------------------------------------
# Documents and object storage
# -----------------------------------------------------------------------------
DOCUMENT_UPLOAD_AI_ANALYSIS=
DOCUMENT_AI_REQUIRE_APPROVED_MODEL=
# Production: True so missing OpenCV/NumPy degrades health and analysis fails safely.
DOCUMENT_AI_REQUIRE_BLUR_CHECK=
# Keep True unless an approved manual-review-only policy replaces type matching.
DOCUMENT_ENFORCE_TYPE_MATCH=True
DOCUMENT_REQUIRE_CNN_FOR_TYPE_VALIDATION=True
# Must match the calibrated policy approved with the model registry entry.
DOCUMENT_TYPE_CONFIDENCE_THRESHOLD=0.75
# Reject decompression bombs and unreasonable dimensions before storage.
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_MAX_IMAGE_WIDTH=12000
DOCUMENT_MAX_IMAGE_HEIGHT=12000
# Development may leave both False. Production requires both True.
DOCUMENT_MALWARE_SCAN_ENABLED=False
DOCUMENT_MALWARE_SCAN_REQUIRED=False
DOCUMENT_MALWARE_SCANNER=clamav
# Private ClamAV daemon/service endpoint; never expose port 3310 publicly.
DOCUMENT_MALWARE_SCAN_HOST=127.0.0.1
DOCUMENT_MALWARE_SCAN_PORT=3310
DOCUMENT_MALWARE_SCAN_TIMEOUT_SECONDS=10
DOCUMENT_MALWARE_SCAN_CHUNK_BYTES=65536
# scan permits structurally validated + malware-scanned PDFs; disabled rejects PDFs.
DOCUMENT_PDF_UPLOAD_POLICY=scan
DOCUMENT_UPLOAD_NOTIFY_REVIEWERS=
DOCUMENT_UPLOAD_NOTIFY_ASYNC=
DOCUMENT_AI_MAX_ATTEMPTS=
DOCUMENT_AI_RETRY_BACKOFF_SECONDS=
DOCUMENT_AI_LEASE_SECONDS=
DOCUMENT_NOTIFICATION_MAX_ATTEMPTS=
DOCUMENT_NOTIFICATION_RETRY_BACKOFF_SECONDS=
DOCUMENT_NOTIFICATION_LEASE_SECONDS=
# Development: local. Production: s3; local storage is rejected when DEBUG=False.
DOCUMENT_STORAGE_BACKEND=local
# Keep False until the isolated S3 validation checklist passes.
DOCUMENT_PRESIGNED_UPLOAD_ENABLED=False
# Development: 900 seconds. Production: keep short and align with client timeout/retry UX.
DOCUMENT_PRESIGNED_UPLOAD_EXPIRY_SECONDS=900
# Development: 300 seconds; must exceed the maximum expected finalize duration.
DOCUMENT_PRESIGNED_FINALIZE_LEASE_SECONDS=300
# Leave empty for local development. Production: prefer workload/IAM identity; otherwise store a restricted key as a secret.
AWS_ACCESS_KEY_ID=
# Leave empty for local development. Production: prefer workload/IAM identity; otherwise rotate and store securely.
AWS_SECRET_ACCESS_KEY=
# Leave empty for local development. Production: private dedicated bucket after S3 settings are wired.
AWS_STORAGE_BUCKET_NAME=
# Production: set to the deployed bucket region.
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=
AWS_S3_SIGNATURE_VERSION=
AWS_S3_OBJECT_PARAMETERS=
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=
AWS_S3_MULTIPART_THRESHOLD_BYTES=
AWS_S3_MULTIPART_CHUNKSIZE_BYTES=
AWS_S3_UPLOAD_MAX_ATTEMPTS=
AWS_S3_UPLOAD_BASE_BACKOFF=
# Policy defaults: 7 years for active/approved metadata, 90 days for superseded/rejected records. Confirm against approved legal policy before deployment.
DOCUMENT_RETENTION_DAYS=2555
DOCUMENT_SUPERSEDED_RETENTION_DAYS=90
DOCUMENT_REJECTED_RETENTION_DAYS=90
DOCUMENT_QUARANTINE_RETENTION_DAYS=1
DOCUMENT_RETENTION_POLICY_VERSION=2026-08-10-v1

# Analytics audit evidence lifecycle. Confirm the retention period and policy
# version with compliance before production; do not shorten it while legal
# holds or an investigation require retained evidence.
ANALYTICS_AUDIT_RETENTION_DAYS=2555
ANALYTICS_AUDIT_RETENTION_POLICY_VERSION=2026-08-12-v1
# Reject oversized or deeply nested producer metadata before it reaches MongoDB.
ANALYTICS_AUDIT_MAX_DETAILS_BYTES=16384
ANALYTICS_AUDIT_MAX_DETAILS_DEPTH=4
# Abort expensive MongoDB Analytics operations after this budget.
ANALYTICS_QUERY_TIMEOUT_MS=3000
# Per-authenticated-user Analytics endpoint throttle; tune from production load evidence.
ANALYTICS_READ_RATE=300/hour
# Bound page-number pagination and active-product dashboard cardinality.
ANALYTICS_MAX_PAGE_OFFSET=10000
ANALYTICS_MAX_ACTIVE_PRODUCTS=100
# Health/alert threshold for unresolved central audit recovery rows.
ANALYTICS_AUDIT_BACKLOG_ALERT_THRESHOLD=1
# Health becomes degraded when the integrity inventory is absent or older than this.
ANALYTICS_INTEGRITY_INVENTORY_MAX_AGE_SECONDS=90000

# Enable the Prometheus endpoint in production and configure exactly one
# transport: WSGI serves /metrics directly; ASGI deployments should enable the
# private sidecar HTTP server and expose it only to the monitoring network.
PROMETHEUS_METRICS_ENABLED=False
PROMETHEUS_METRICS_HTTP_SERVER_ENABLED=False
PROMETHEUS_METRICS_HTTP_SERVER_PORT=8001
# Optional operator-facing values used by the metrics toggle/status tooling.
PROMETHEUS_METRICS_URL=
PROMETHEUS_METRICS_BASE_URL=

# -----------------------------------------------------------------------------
# Encrypted backups
# -----------------------------------------------------------------------------
# Production: rotate before launch and escrow securely; losing it makes backups unrecoverable.
BACKUP_ENCRYPTION_PASSPHRASE= ++lv
# Development: local path. Production: protected volume outside the application checkout.
BACKUP_OUTPUT_DIR=
# Production: set from the approved retention policy.
BACKUP_RETENTION_DAYS=
# Development may stay empty. Production: configure an encrypted offsite destination.
BACKUP_OFFSITE_RCLONE_REMOTE=
# Keep pointed at a non-production restore-test database.
BACKUP_RESTORE_DB_NAME=

# -----------------------------------------------------------------------------
# Blockchain runtime
# -----------------------------------------------------------------------------
# Development: enable only with a local/test chain. Production: enable only after contract, wallet, and network review.
BLOCKCHAIN_ENABLED=
# Production: replace with the approved authenticated RPC endpoint.
BLOCKCHAIN_RPC_URL=
# Production: set to the exact deployed network chain ID.
BLOCKCHAIN_CHAIN_ID=
# Production: rotate and use managed signing/HSM custody where possible. Never reuse a development key.
BLOCKCHAIN_WALLET_KEY=
# Production: replace with reviewed deployment addresses for the selected chain.
BLOCKCHAIN_CONTRACT_ADDRESSES=
BLOCKCHAIN_GAS_LIMIT=
BLOCKCHAIN_GAS_PRICE_GWEI=
# Development can remain empty. Production: set the explorer base URL for the selected network.
BLOCKCHAIN_EXPLORER_URL=
# Development local chain: 1. Production: choose based on network reorg/finality risk.
LOANS_WALLET_MIN_CONFIRMATIONS=

# Bound synchronous loan exports and each leased background-job invocation.
LOAN_EXPORT_MAX_ROWS=10000
# Maximum records per Loans collection included in one account portability export.
LOAN_ACCOUNT_EXPORT_MAX_ROWS=5000
# Bound each operational application/schedule consistency sample.
LOAN_OPERATIONAL_INTEGRITY_SCAN_LIMIT=1000
# Seven-year baseline; production must use the approved legal/privacy policy.
LOAN_RETENTION_DAYS=2555
LOAN_RETENTION_POLICY_VERSION=2026-08-15-v1
LOAN_NOTIFICATION_MAX_ATTEMPTS=5
LOAN_NOTIFICATION_RETRY_BACKOFF_SECONDS=60
LOAN_NOTIFICATION_LEASE_SECONDS=300
LOAN_JOB_BATCH_SIZE=200
LOAN_JOB_MAX_BATCHES=10
LOAN_JOB_LEASE_SECONDS=900
# Soft/hard Celery execution bounds; keep the hard limit at or below the lease.
LOAN_TASK_SOFT_TIME_LIMIT=840
LOAN_TASK_TIME_LIMIT=900
# Stage 6 read-only inventory ceiling. Raise only after reviewing target size/cost.
LOANS_RELEASE_INVENTORY_LIMIT=10000

# Stage 6 evidence flags. Keep False in development. Set each one to True only
# after the named check has passed in the final deployment topology and its
# evidence has been reviewed; these flags do not perform or replace the tests.
LOANS_RETENTION_POLICY_APPROVED=False
LOANS_DEPLOYMENT_MONGODB_VERIFIED=False
LOANS_REDIS_CELERY_VERIFIED=False
# Leave False when blockchain is disabled. If blockchain is enabled, set True
# only after the approved network/contract/signer/recovery checks pass.
LOANS_BLOCKCHAIN_VERIFIED=False
LOANS_HTTPS_API_LOAD_VERIFIED=False
LOANS_BACKUP_RESTORE_VERIFIED=False
LOANS_SECRET_ROTATION_VERIFIED=False
LOANS_INCIDENT_ROLLBACK_APPROVED=False
LOANS_MONITORING_ALERTS_VERIFIED=False
LOANS_FULL_SUITE_SMOKE_VERIFIED=False

# -----------------------------------------------------------------------------
# Legacy blockchain variables (not consumed by Django settings)
# -----------------------------------------------------------------------------
# Legacy and unused by config/settings.py. Duplicate definitions were consolidated using the last effective value; remove after credential rotation and confirming no external script depends on it.
PRIVATE_KEY=
# Legacy and unused by config/settings.py; remove after confirming no external tooling depends on it.
BACKEND_WALLET=
# Development-only secret; never deploy and remove before production.
GANACHE_MNEMONIC=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
GANACHE_RPC_URL=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
LOCALHOST_RPC_URL=
# Legacy alias; the backend uses BLOCKCHAIN_RPC_URL.
SEPOLIA_RPC_URL=
